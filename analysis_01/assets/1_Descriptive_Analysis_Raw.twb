      <column caption='Company Size' datatype='string' name='[Calculation_0991800795041800]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [employees] &lt;= 8525 THEN&#13;&#10;    &quot;Small&quot; + CHAR(10) + &quot;Company&quot;&#13;&#10;ELSEIF [employees] &lt;= 34000 THEN&#13;&#10;    &quot;Medium-Sized&quot; + CHAR(10) + &quot;Company&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Big&quot; + CHAR(10) + &quot;Company&quot;&#13;&#10;END' />
