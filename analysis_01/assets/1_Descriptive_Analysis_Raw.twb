              <calculation class='tableau' formula='(&#13;&#10;    IF [sdg_no_poverty] IN (&quot;Aligned&quot;, &quot;Strongly Aligned&quot;) THEN 1 ELSE 0 END&#13;&#10;    + IF [sdg_no_hunger] IN (&quot;Aligned&quot;, &quot;Strongly Aligned&quot;) THEN 1 ELSE 0 END&#13;&#10;    + IF [sdg_good_health] IN (&quot;Aligned&quot;, &quot;Strongly Aligned&quot;) THEN 1 ELSE 0 END&#13;&#10;    + IF [sdg_quality_education] IN (&quot;Aligned&quot;, &quot;Strongly Aligned&quot;) THEN 1 ELSE 0 END&#13;&#10;    + IF [sdg_gender_equality] IN (&quot;Aligned&quot;, &quot;Strongly Aligned&quot;) THEN 1 ELSE 0 END&#13;&#10;    + IF [sdg_clean_water] IN (&quot;Aligned&quot;, &quot;Strongly Aligned&quot;) THEN 1 ELSE 0 END&#13;&#10;    + IF [sdg_clean_energy] IN (&quot;Aligned&quot;, &quot;Strongly Aligned&quot;) THEN 1 ELSE 0 END&#13;&#10;    + IF [sdg_decent_work] IN (&quot;Aligned&quot;, &quot;Strongly Aligned&quot;) THEN 1 ELSE 0 END&#13;&#10;    + IF [sdg_industry_innovation] IN (&quot;Aligned&quot;, &quot;Strongly Aligned&quot;) THEN 1 ELSE 0 END&#13;&#10;    + IF [sdg_reduced_inequalities] IN (&quot;Aligned&quot;, &quot;Strongly Aligned&quot;) THEN 1 ELSE 0 END&#13;&#10;    + IF [sdg_sustainable_cities] IN (&quot;Aligned&quot;, &quot;Strongly Aligned&quot;) THEN 1 ELSE 0 END&#13;&#10;    + IF [sdg_responsible_consumption] IN (&quot;Aligned&quot;, &quot;Strongly Aligned&quot;) THEN 1 ELSE 0 END&#13;&#10;    + IF [sdg_climate_action] IN (&quot;Aligned&quot;, &quot;Strongly Aligned&quot;) THEN 1 ELSE 0 END&#13;&#10;    + IF [sdg_life_below_water] IN (&quot;Aligned&quot;, &quot;Strongly Aligned&quot;) THEN 1 ELSE 0 END&#13;&#10;    + IF [sdg_life_on_land] IN (&quot;Aligned&quot;, &quot;Strongly Aligned&quot;) THEN 1 ELSE 0 END&#13;&#10;    + IF [sdg_peace_justice] IN (&quot;Aligned&quot;, &quot;Strongly Aligned&quot;) THEN 1 ELSE 0 END&#13;&#10;    + IF [sdg_partnerships] IN (&quot;Aligned&quot;, &quot;Strongly Aligned&quot;) THEN 1 ELSE 0 END&#13;&#10;)&#13;&#10;/&#13;&#10;17.0' />
