        <calculation class='tableau' formula='UPPER(&#13;&#10;    IF LEN([company_name]) &gt; 25 THEN&#13;&#10;        REGEXP_REPLACE(&#13;&#10;            [company_name],&#13;&#10;            &quot;^(.{1,25}) &quot;,&#13;&#10;            &quot;$1&quot; + CHAR(10)&#13;&#10;        )&#13;&#10;    ELSE&#13;&#10;        [company_name]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Dummy_02' datatype='string' name='[Calculation_0890096337281032]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Dummy&quot;' />
