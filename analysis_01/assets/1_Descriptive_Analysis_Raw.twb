      <column caption='Piotroski Index' datatype='real' name='[Calculation_1184489452228608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN([piotroski_score])' />
      </column>
      <column caption='Piotroski Interpretation' datatype='string' name='[Calculation_1184489458880513]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1184489452228608] &lt;= 3 THEN &quot;Weak&quot;&#13;&#10;ELSEIF [Calculation_1184489452228608] &lt;= 6 THEN &quot;Moderate&quot;&#13;&#10;ELSE &quot;Strong&quot;&#13;&#10;END' />
      </column>
      <column caption='Altman Index' datatype='real' name='[Calculation_1184489466310660]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN([altman_score])' />
      </column>
      <column caption='Altman Text' datatype='string' name='[Calculation_1245239266967553]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1184489466310660] &gt; 2.99 THEN&#13;&#10;    &quot;Strong financial health with low risk of distress.&quot;&#13;&#10;ELSEIF [Calculation_1184489466310660] &gt;= 1.81 THEN&#13;&#10;    &quot;Moderate financial health with some uncertainty and financial risk.&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Weak financial health with elevated risk of financial distress.&quot;&#13;&#10;END' />
      </column>
      <column caption='Piotroski Text' datatype='string' name='[Calculation_1245239267536898]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1184489452228608] &lt;= 3 THEN&#13;&#10;    &quot;Weak financial strength, indicating poor fundamentals and higher financial risk.&quot;&#13;&#10;ELSEIF [Calculation_1184489452228608] &lt;= 6 THEN&#13;&#10;    &quot;Moderate financial strength, indicating mixed fundamentals and an average financial position.&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Strong financial strength, indicating healthy fundamentals and a stronger financial position.&quot;&#13;&#10;END' />
      </column>
      <column caption='ESG Text' datatype='string' name='[Calculation_1245239267811331]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [esg_score] &lt; 10 THEN&#13;&#10;    &quot;Negligible ESG risk, indicating strong management of environmental, social, and governance issues.&quot;&#13;&#10;ELSEIF [esg_score] &lt; 20 THEN&#13;&#10;    &quot;Low ESG risk, indicating limited exposure to material environmental, social, and governance issues.&quot;&#13;&#10;ELSEIF [esg_score] &lt; 30 THEN&#13;&#10;    &quot;Medium ESG risk, indicating a moderate level of exposure to material ESG issues.&quot;&#13;&#10;ELSEIF [esg_score] &lt; 40 THEN&#13;&#10;    &quot;High ESG risk, indicating significant exposure to material ESG issues.&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Severe ESG risk, indicating extensive exposure to material ESG issues and potentially significant financial impact.&quot;&#13;&#10;END' />
      </column>
