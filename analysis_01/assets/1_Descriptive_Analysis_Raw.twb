              <calculation class='tableau' formula='IF [esg_score] &lt; 10 THEN&#13;&#10;    &quot;Negligible ESG risk, indicating strong management of environmental, social, and governance issues.&quot;&#13;&#10;ELSEIF [esg_score] &lt; 20 THEN&#13;&#10;    &quot;Low ESG risk, indicating limited exposure to material environmental, social, and governance issues.&quot;&#13;&#10;ELSEIF [esg_score] &lt; 30 THEN&#13;&#10;    &quot;Medium ESG risk, indicating a moderate level of exposure to material ESG issues.&quot;&#13;&#10;ELSEIF [esg_score] &lt; 40 THEN&#13;&#10;    &quot;High ESG risk, indicating significant exposure to material ESG issues.&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Severe ESG risk, indicating extensive exposure to material ESG issues and potentially significant financial impact.&quot;&#13;&#10;END' />
